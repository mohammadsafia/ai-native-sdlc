# Database (Docker Compose brings up Postgres on port 5433)
DATABASE_URL=postgresql://sdlc:sdlc@localhost:5433/sdlc

# Server port (default: 3001)
PORT=3001

# Jira Cloud credentials — fill these in before running the Jira connector
# Create API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your.email@company.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=PROJ
