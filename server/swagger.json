{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "time": {
                      "type": "string",
                      "example": "2026-06-03T16:24:18.377Z"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Health check",
        "tags": [
          "Health"
        ]
      }
    },
    "/api/sync/{projectKey}": {
      "post": {
        "operationId": "JiraController_sync",
        "parameters": [
          {
            "name": "projectKey",
            "required": true,
            "in": "path",
            "description": "Jira project key, e.g. PROJ",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Sync completed successfully"
          }
        },
        "summary": "Trigger a Jira project sync",
        "tags": [
          "sync"
        ]
      }
    },
    "/api/projects/{key}/weekly-report": {
      "get": {
        "operationId": "ReportController_getWeeklyReport",
        "parameters": [
          {
            "name": "key",
            "required": true,
            "in": "path",
            "description": "Jira project key",
            "schema": {
              "example": "PROJ",
              "type": "string"
            }
          },
          {
            "name": "windowDays",
            "required": false,
            "in": "query",
            "description": "Reporting window in days (default 7)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "staleDays",
            "required": false,
            "in": "query",
            "description": "Days of inactivity before story is stale (default 3)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "overloadThreshold",
            "required": false,
            "in": "query",
            "description": "Max concurrent in-progress per assignee before resource-overload risk fires (default 5)",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Weekly status & risk report for the project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeeklyReportDto"
                }
              }
            }
          }
        },
        "tags": [
          "report"
        ]
      }
    },
    "/api/projects": {
      "get": {
        "operationId": "ProjectsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List all projects with health summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProjectSummaryDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "projects"
        ]
      }
    },
    "/api/projects/{key}": {
      "get": {
        "operationId": "ProjectsController_findOne",
        "parameters": [
          {
            "name": "key",
            "required": true,
            "in": "path",
            "description": "Jira project key",
            "schema": {
              "example": "PROJ",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single project health summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectSummaryDto"
                }
              }
            }
          }
        },
        "tags": [
          "projects"
        ]
      }
    }
  },
  "info": {
    "title": "AI-Native SDLC API",
    "description": "Backend API for the AI-Native SDLC Platform — Jira ingestion, normalization, and weekly reports",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Health",
      "description": ""
    },
    {
      "name": "Sync",
      "description": ""
    },
    {
      "name": "Projects",
      "description": ""
    },
    {
      "name": "Reports",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "schemas": {
      "ReportSummaryDto": {
        "type": "object",
        "properties": {
          "done": {
            "type": "number",
            "example": 5,
            "description": "Number of done artifacts in the active sprint"
          },
          "inProgress": {
            "type": "number",
            "example": 3,
            "description": "Number of in-progress artifacts (excluding blocked)"
          },
          "todo": {
            "type": "number",
            "example": 4,
            "description": "Number of to-do artifacts in the active sprint"
          },
          "blocked": {
            "type": "number",
            "example": 1,
            "description": "Number of blocked artifacts"
          },
          "pointsCompleted": {
            "type": "number",
            "example": 13,
            "description": "Sum of story points for done artifacts in the active sprint"
          },
          "pointsCommitted": {
            "type": "number",
            "example": 21,
            "description": "Sum of story points committed in the active sprint (all sprint artifacts)"
          }
        },
        "required": [
          "done",
          "inProgress",
          "todo",
          "blocked",
          "pointsCompleted",
          "pointsCommitted"
        ]
      },
      "ReportItemDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "PROJ-42",
            "description": "Jira issue key"
          },
          "title": {
            "type": "string",
            "example": "Implement login flow",
            "description": "Issue summary / title"
          },
          "assignee": {
            "type": "string",
            "example": "Alice Smith",
            "description": "Assignee display name"
          }
        },
        "required": [
          "key",
          "title",
          "assignee"
        ]
      },
      "RiskDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "risk-1",
            "description": "Unique identifier for the risk"
          },
          "projectId": {
            "type": "string",
            "example": "PROJ",
            "description": "Project key this risk belongs to"
          },
          "kind": {
            "type": "string",
            "enum": [
              "delivery",
              "scope_creep",
              "dependency",
              "resource_overload"
            ],
            "example": "scope_creep",
            "description": "Risk category"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "example": "high",
            "description": "Risk severity"
          },
          "subjectRef": {
            "type": "string",
            "example": "PROJ-99",
            "description": "Jira key of the subject artifact"
          },
          "title": {
            "type": "string",
            "example": "Scope creep: issue added after sprint start",
            "description": "Short risk title"
          },
          "evidence": {
            "type": "string",
            "example": "PROJ-99 was added to sprint after start date",
            "description": "Evidence for the risk"
          },
          "recommendation": {
            "type": "string",
            "example": "Review with PM whether this should be moved to backlog",
            "description": "Recommended action"
          }
        },
        "required": [
          "id",
          "projectId",
          "kind",
          "severity",
          "subjectRef",
          "title",
          "evidence",
          "recommendation"
        ]
      },
      "WeeklyReportDto": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "example": "proj-cuid",
            "description": "Project database ID"
          },
          "projectKey": {
            "type": "string",
            "example": "PROJ",
            "description": "Jira project key"
          },
          "periodEnd": {
            "type": "string",
            "example": "2026-06-06",
            "description": "ISO date string of the reporting period end (Friday)"
          },
          "generatedAt": {
            "type": "string",
            "example": "2026-06-03T00:00:00.000Z",
            "description": "ISO timestamp when this report was generated"
          },
          "dataCompleteness": {
            "type": "number",
            "example": 0.8,
            "description": "Fraction [0–1] indicating how complete the data is. < 1.0 means some signals are unavailable (e.g. commit-based staleness requires the Bitbucket connector)."
          },
          "summary": {
            "$ref": "#/components/schemas/ReportSummaryDto"
          },
          "inProgress": {
            "description": "In-progress artifacts (not blocked)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportItemDto"
            }
          },
          "completed": {
            "description": "Completed artifacts in the active sprint",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportItemDto"
            }
          },
          "staleStories": {
            "description": "In-progress artifacts with no Jira activity for longer than staleDays. NOTE: staleness is Jira-update-based; commit-based staleness arrives with the Bitbucket connector.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportItemDto"
            }
          },
          "idlePrs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "daysIdle": {
                  "type": "number"
                }
              }
            },
            "description": "Idle PRs — placeholder; populated by the Bitbucket connector (next slice)"
          },
          "risks": {
            "description": "Computed risks: scope_creep and resource_overload for this slice",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RiskDto"
            }
          },
          "narrative": {
            "type": "string",
            "example": "Sprint had 5 done, 3 in-progress, 1 blocked, 4 todo. 1 stale story (PROJ-10). 2 scope-creep risks detected.",
            "description": "Deterministic narrative summary of this report. [[KEY]] tokens mark evidence references. A real Claude-generated narrative arrives with the LLM gateway (next slice)."
          }
        },
        "required": [
          "projectId",
          "projectKey",
          "periodEnd",
          "generatedAt",
          "dataCompleteness",
          "summary",
          "inProgress",
          "completed",
          "staleStories",
          "idlePrs",
          "risks",
          "narrative"
        ]
      },
      "HealthScoreDto": {
        "type": "object",
        "properties": {
          "overall": {
            "type": "number",
            "example": 72,
            "description": "Composite health score 0–100"
          },
          "label": {
            "type": "string",
            "enum": [
              "healthy",
              "at-risk",
              "blocked"
            ],
            "example": "at-risk"
          }
        },
        "required": [
          "overall",
          "label"
        ]
      },
      "ProjectSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "proj-cuid",
            "description": "Project database ID"
          },
          "key": {
            "type": "string",
            "example": "PROJ",
            "description": "Jira project key"
          },
          "name": {
            "type": "string",
            "example": "My Project",
            "description": "Project name"
          },
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "at-risk",
              "blocked"
            ],
            "example": "healthy"
          },
          "health": {
            "$ref": "#/components/schemas/HealthScoreDto"
          },
          "lastSyncedAt": {
            "type": "string",
            "example": "2026-06-03T12:00:00.000Z",
            "nullable": true
          },
          "openRiskCount": {
            "type": "number",
            "example": 2,
            "description": "Number of open (non-resolved) risks"
          }
        },
        "required": [
          "id",
          "key",
          "name",
          "status",
          "health",
          "lastSyncedAt",
          "openRiskCount"
        ]
      }
    }
  }
}